# LA Glass — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.

# Public site URL after the final domain is chosen
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Quote form delivery (server-only) ---
#
# Quote requests are forwarded by FormSubmit (https://formsubmit.co).
# No API key is needed. The inbox below must be activated ONCE: the first
# submission sends a confirmation email there — click the link in it and
# every later submission is forwarded automatically.

# Inbox that receives quote requests.
CONTACT_EMAIL=hovsephalajyan@gmail.com

# Optional. After activation, FormSubmit gives you a random endpoint code.
# Setting it here keeps the email address out of the outbound request too.
FORMSUBMIT_TOKEN=
